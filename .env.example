# Copy to .env for local use (or use .streamlit/secrets.toml). NEVER commit real values.
# Use the ANON / publishable key only. NEVER put the service-role key here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Demo city used for sample vans (all labelled as demo)
DEMO_CITY_NAME=Hyderabad
DEMO_CITY_LAT=17.3850
DEMO_CITY_LON=78.4867

# Optional: place-name search via OpenStreetMap Nominatim (low volume only)
GEOCODING_ENABLED=false
APP_TIMEZONE=Asia/Kolkata
